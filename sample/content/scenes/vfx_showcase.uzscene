{
  "name": "VFX Showcase",
  "version": "1.0",
  "description": "Demonstrates all VFX particle presets in a single scene",
  "entities": [
    {
      "name": "Sun",
      "components": {
        "transform": { "position": [0, 0, 920], "rotation": [60, -30, 0] },
        "light": { "type": "directional", "color": [1.0, 0.95, 0.85], "intensity": 8 }
      }
    },
    {
      "name": "SkyAtmosphere",
      "components": {
        "sky_atmosphere": {}
      }
    },
    {
      "name": "GroundPlane",
      "components": {
        "transform": { "position": [0, 0, 0], "scale": [5000, 5000, 2] },
        "mesh": { "asset": "meshes/cube.uzmesh" },
        "material": { "baseColorTint": [0.2, 0.2, 0.2], "roughnessMultiplier": 0.9 }
      }
    },
    {
      "name": "Fireball",
      "components": {
        "transform": { "position": [-600, 0, 200] },
        "vfx_emitter": { "asset": "vfx/presets/fireball.json", "emitting": true }
      }
    },
    {
      "name": "SmokeColumn",
      "components": {

{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zig",
  "scopeName": "source.zig",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.zig", "match": "//.*$" }
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.double.zig", "begin": "\"", "end": "\"", "patterns": [
          { "name": "constant.character.escape.zig", "match": "\\\\[nrt'\"\\\\]|\\\\x[0-9a-fA-F]{2}|\\\\u\\{[0-9a-fA-F]+\\}" }
        ]},
        { "name": "string.quoted.single.zig", "begin": "'", "end": "'", "patterns": [
          { "name": "constant.character.escape.zig", "match": "\\\\[nrt'\"\\\\]|\\\\x[0-9a-fA-F]{2}|\\\\u\\{[0-9a-fA-F]+\\}" }
        ]}
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.zig", "match": "\\b0x[0-9a-fA-F_]+\\b" },
        { "name": "constant.numeric.octal.zig", "match": "\\b0o[0-7_]+\\b" },
        { "name": "constant.numeric.binary.zig", "match": "\\b0b[01_]+\\b" },
        { "name": "constant.numeric.float.zig", "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?\\b" },
        { "name": "constant.numeric.integer.zig", "match": "\\b[0-9][0-9_]*\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.zig", "match": "\\b(if|else|for|while|switch|break|continue|return|defer|errdefer|unreachable|try|catch|orelse)\\b" },
        { "name": "storage.type.zig", "match": "\\b(fn|const|var|pub|extern|export|inline|noinline|comptime|threadlocal|volatile|align|packed|struct|enum|union|error|opaque|test)\\b" },
        { "name": "constant.language.zig", "match": "\\b(true|false|null|undefined)\\b" },
        { "name": "keyword.other.zig", "match": "\\b(asm|nosuspend|async|await|suspend|resume|usingnamespace|linksection|callconv)\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "support.type.zig", "match": "\\b(void|noreturn|type|anyerror|anytype|anyframe|bool|anyopaque|isize|usize|comptime_int|comptime_float)\\b" },
        { "name": "support.type.integer.zig", "match": "\\b([iu][0-9]+|f16|f32|f64|f80|f128|c_char|c_short|c_ushort|c_int|c_uint|c_long|c_ulong|c_longlong|c_ulonglong|c_longdouble)\\b" }
      ]
    },
    "builtins": {
      "patterns": [
        { "name": "support.function.builtin.zig", "match": "@[a-zA-Z_][a-zA-Z0-9_]*" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.zig", "match": "(\\+\\+|--|\\+%|-%|\\*%|<<|>>|&|\\||\\^|~|==|!=|<=|>=|<|>|\\+|\\-|\\*|/|%)" }
      ]
    }
  }
}

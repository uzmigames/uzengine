{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "Agent(*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/detect-gaps.sh 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Detecting codebase gaps..."
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash U:/UzmiEngine/uzengine/.claude/hooks/on-compact-reinject.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash U:/UzmiEngine/uzengine/.claude/hooks/resume-from-handoff.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash(git commit*)",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/validate-commit.sh 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Validating commit..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash U:/UzmiEngine/uzengine/.claude/hooks/enforce-no-deferred.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash U:/UzmiEngine/uzengine/.claude/hooks/enforce-no-shortcuts.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash U:/UzmiEngine/uzengine/.claude/hooks/enforce-mcp-for-tasks.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash U:/UzmiEngine/uzengine/.claude/hooks/check-context-and-handoff.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash .claude/statusline.sh 2>/dev/null || echo UzEngine"
  },
  "enabledMcpjsonServers": [
    "tml",
    "rulebook",
    "uzengine"
  ]
}

# Sandbox — test outputs, Falcor references, temp captures (never committed)
.sandbox/

# Local toolchains pinned to project (e.g. zig 0.15.2 download)
.tools/

# Rulebook - ignore runtime data, keep specs and tasks
/.rulebook/*
!/.rulebook/specs/
!/.rulebook/tasks/
!/.rulebook/tasks/**/*.md
!/.rulebook/decisions/
!/.rulebook/knowledge/
!/.rulebook/learnings/
!/.rulebook/archive/
!/.rulebook/rules/
!/.rulebook/rulebook.json


# Compiled shaders
*.cso
*.dxil

# Engine cache (generated, never committed)
cache/
**/cache/shaders/
**/cache/textures/
**/cache/cooked/
screenshots
backup

# Cooked assets (build output)
*.uzpak

# Compiled textures (generated from source PNGs)
*.dds

# Mesh binary blobs (generated by importer)
content/**/*.bin

# Coverage
coverage/

# POC (backup reference, not part of main build)
poc-napi/build/
poc-napi/out/
poc-napi/node_modules/

# Screenshots — debug/comparison captures (never commit)
/.screenshots/
/.captures/

# Cooked texture outputs (generated by uzcook, never commit)
*.uztexture
*.uzimport
.cache/

# 3D Raw Model
*.glb
*.gltf
*.fbx
*.obj
*.stl

# NVIDIA DLSS SDK (proprietary, downloaded via setup.ps1, ~200MB)
runtime/thirdparty/dlss/

# Local macOS/Linux thirdparty binaries (Slang SDK dylibs, LuaJIT build output —
# platform-specific, never committed; Windows/Linux fetch or build their own)
runtime/thirdparty/slang/bin/*.dylib
runtime/thirdparty/slang/lib/
runtime/thirdparty/luajit/src/libluajit.*

CLAUDE.local.md
.rulebook/backup/
.rulebook/handoff/_pending.md
.rulebook/handoff/.urgent
.rulebook/telemetry/


# Rulebook - ignore runtime data, keep specs and tasks
/.rulebook/*
!/.rulebook/specs/
!/.rulebook/tasks/
!/.rulebook/tasks/**/*.md
!/.rulebook/decisions/
!/.rulebook/knowledge/
!/.rulebook/learnings/
!/.rulebook/rules/
!/.rulebook/rulebook.json

# Patterns added by @hivellm/rulebook
# Added at: 2026-03-10T17:05:03.334Z

*.log
*.swo
*.swp
*~
.DS_Store
.cache/
.env
.env.*.local
.env.local
.idea/

# Claude Code
.claude/settings.local.json
.claude/worktrees/
Thumbs.db
logs/
temp/
tmp/

# Zig
.zig-cache/
zig-out/
build/

# Node
node_modules/
package-lock.json

# Build artifacts
napi/build/
extension/out/
extension/native/
mcp/dist/
mcp/data/

# C++ build
*.obj
*.o
*.lib
*.dll
*.pdb
*.exp
*.ilk
*.exe

# Compiled shaders
*.cso
*.dxil

# Engine cache (generated, never committed)
cache/
**/cache/shaders/
**/cache/textures/
**/cache/cooked/
screenshots

# Cooked assets (build output)
*.uzpak

# Compiled textures (generated from source PNGs)
*.dds

# Mesh binary blobs (generated by importer)
content/**/*.bin

# Coverage
coverage/

# POC (backup reference, not part of main build)
poc-napi/build/
poc-napi/out/
poc-napi/node_modules/

# Screenshots — debug/comparison captures (never commit)
/.screenshots/
/.captures/

# Cooked texture outputs (generated by uzcook, never commit)
*.uztexture
*.uzimport
.cache/

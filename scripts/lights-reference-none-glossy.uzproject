{
  "name": "Glossy floor, no local lights (the ambient of the source-radius scenes)",
  "version": "1.0",
  "content_root": "../sample/content",
  "default_scene": "scenes/lights-reference-none-glossy.uzscene",
  "window": {
    "width": 1920,
    "height": 1080
  },
  "cvars": {
    "r.AutoExposure": 0,
    "r.Exposure": 1,
    "r.GTAO": 0,
    "r.RadianceCache": 0,
    "r.GI.FinalGather": 0,
    "r.GI.Reflections": 0,
    "r.SSGI": 0,
    "r.TAA": 1,
    "r.Fog": 0,
    "r.VolumetricFog": 0,
    "r.TechPanel.Show": 0
  }
}
      "material": {"baseColorR": 0.6, "baseColorG": 0.6, "baseColorB": 0.6,
                   "roughnessMultiplier": 1, "metallicMultiplier": 0}
    }},
    {"name": "Wall", "components": {
      "transform": {"position": [0, 190, 0], "scale": [90, 3, 55]},
      "mesh": {"asset": "sample/content/meshes/cube.uzmesh"},
      "material": {"baseColorR": 0.6, "baseColorG": 0.6, "baseColorB": 0.6,
                   "roughnessMultiplier": 1, "metallicMultiplier": 0}
    }},
    {"name": "Rough floor", "components": {
      "transform": {"position": [0, 0, -20], "scale": [700, 700, 10]},

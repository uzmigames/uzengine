      "material": {"baseColorR": 0, "baseColorG": 0, "baseColorB": 0,
                   "roughnessMultiplier": 1, "metallicMultiplier": 0,
                   "emissiveColorR": 1, "emissiveColorG": 1, "emissiveColorB": 1, "emissiveIntensity": 2.5}
    }},
    {"name": "Occluder", "components": {
      "transform": {"position": [0, 0, 0], "scale": [25, 25, 30]},

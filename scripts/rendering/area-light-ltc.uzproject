{
  "name": "Rect area light (LTC) validation: raster vs path tracer",
  "version": "1.0",
  "content_root": "../..",
  "default_scene": "scripts/rendering/area-light-ltc.uzscene",
  "window": {
    "width": 1280,
    "height": 720
  },
  "cvars": {
    "r.AutoExposure": 0,
    "r.Exposure": 1,
    "r.TonemapOperator": 0,
    "r.Bloom": 0,
    "r.TAA": 1,
    "r.Fog": 0,
    "r.VolumetricFog": 0,
    "r.TechPanel.Show": 0,
    "r.Toolbar.Show": 0,
    "r.GTAO": 0,
    "r.SSGI": 0,
    "r.RadianceCache": 0,
    "r.GI.FinalGather": 0,
    "r.GI.Reflections": 0,
    "r.SSR": 0,
    "r.LightBVH": 1,
    "r.PathTracer.MaxBounces": 2,
    "r.PathTracer.NEESamples": 4
  }
}

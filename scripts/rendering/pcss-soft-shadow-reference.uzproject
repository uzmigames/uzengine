{
  "name": "PCSS soft shadow reference",
  "version": "1.0",
  "content_root": "../..",
  "default_scene": "scripts/rendering/pcss-soft-shadow-reference.uzscene",
  "window": {
    "width": 1280,
    "height": 720
  },
  "cvars": {
    "r.AutoExposure": 0,
    "r.Exposure": 1,
    "r.Bloom": 0,
    "r.TAA": 0,
    "r.Fog": 0,
    "r.VolumetricFog": 0,
    "r.TechPanel.Show": 0,
    "r.Toolbar.Show": 0,
    "r.GTAO": 0,
    "r.SSGI": 0,
    "r.RadianceCache": 0,
    "r.GI.FinalGather": 0,
    "r.GI.Reflections": 0,
    "r.SSR": 0,
    "r.ContactShadows": 0
  }
}

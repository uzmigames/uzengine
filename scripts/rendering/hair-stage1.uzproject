{
  "name": "DXR Chiang hair stage 1",
  "version": "1.0",
  "content_root": "../..",
  "default_scene": "scripts/rendering/hair-stage1.uzscene",
  "window": {"width": 640, "height": 480},
  "cvars": {
    "r.AutoExposure": 0, "r.Exposure": 1, "r.Bloom": 0,
    "r.TonemapOperator": 0, "r.TAA": 0, "r.Fog": 0, "r.VolumetricFog": 0,
    "r.TechPanel.Show": 0, "r.Toolbar.Show": 0,
    "r.GTAO": 0, "r.SSGI": 0, "r.RadianceCache": 0,
    "r.GI.FinalGather": 0, "r.GI.Reflections": 0,
    "r.PathTracer.MaxBounces": 4, "r.PathTracer.NEESamples": 4
  }
}

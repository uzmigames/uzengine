{
  "name": "Heterogeneous grid media (DXR path tracer)",
  "version": "1.0",
  "content_root": ".",
  "default_scene": "path-volume-grid-slab.uzscene",
  "window": {
    "width": 320,
    "height": 180
  },
  "cvars": {
    "r.AutoExposure": 0,
    "r.Exposure": 1,
    "r.Bloom": 0,
    "r.TAA": 1,
    "r.Fog": 0,
    "r.VolumetricFog": 0,
    "r.TechPanel.Show": 0,
    "r.Toolbar.Show": 0,
    "r.GTAO": 0,
    "r.SSGI": 0,
    "r.RadianceCache": 0,
    "r.GI.FinalGather": 0,
    "r.GI.Reflections": 0,
    "r.PathTracer.MaxBounces": 1
  }
}

{
  "name": "GDF incremental reference",
  "version": "1.0",
  "content_root": "../sample/content",
  "default_scene": "scenes/gdf-incremental-reference.uzscene",
  "window": {
    "width": 640,
    "height": 360
  },
  "cvars": {
    "r.RadianceCache": 1,
    "r.GI.Reflections": 1,
    "r.GI.FinalGather": 1,
    "r.GI.GDF.Resolution": 256,
    "r.GI.MeshSdf.Resolution": 128,
    "r.GI.MeshSdf.TwoSided": 1,
    "r.GI.RadianceCache.GridExtent": 2000,
    "r.TAA": 1,
    "r.AutoExposure": 0,
    "r.Exposure": 1.0,
    "r.TechPanel.Show": 0,
    "r.GTAO": 0,
    "r.GI.RadianceCache.Diagnostic": 1
  }
}
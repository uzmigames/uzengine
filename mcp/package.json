{
  "name": "@uzmigames/uzengine-mcp",
  "version": "0.2.0",
  "private": true,
  "description": "UzEngine MCP server — AI tool invocations, scene queries, autonomous development",
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/src/server.js --stdio",
    "dev": "tsc -w -p .",
    "generate-docs": "node --import tsx tools/generate-docs.ts",
    "generate-docs:watch": "node --import tsx tools/generate-docs.ts --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "type-check": "tsc -p tsconfig.test.json",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "4.1.12",
    "chokidar": "^6.0.0",
    "eslint": "^10.13.0",
    "glob": "^13.0.6",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "4.1.12"
  }
}

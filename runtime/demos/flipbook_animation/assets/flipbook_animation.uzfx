{
  "name": "Flipbook Animation",
  "version": 1,
  "emitter": {
    "max_particles": 10000,
    "emission_rate": 200.0,
    "lifetime": 2.0,
    "looping": true
  },
  "modules": {
    "spawn": {
      "type": "spawn",
      "velocity": [0.0, 5.0, 0.0],
      "spread_angle": 45.0,
      "lifespan_min": 0.5,
      "lifespan_max": 2.0,
      "rate": 200.0
    },
    "update": [
      {
        "type": "update",
        "gravity": [0.0, -2.0, 0.0],
        "drag": 0.97
      },
      {
        "type": "decay"
      }
    ],
    "render": {
      "type": "sprite",
      "width": 1.0,
      "height": 1.0,
      "flipbook_rows": 4,
      "flipbook_cols": 4,
      "flipbook_total_frames": 16,
      "flipbook_fps": 24.0,
      "flipbook_blend_mode": "linear"
    }
  }
}

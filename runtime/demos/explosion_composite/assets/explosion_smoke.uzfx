{
  "name": "Explosion Smoke",
  "version": 1,
  "emitter": {
    "max_particles": 15000,
    "emission_rate": 200.0,
    "lifetime": 4.0,
    "looping": true,
    "start_delay": 0.2
  },
  "modules": {
    "spawn": {
      "type": "spawn",
      "velocity": [0.0, 3.0, 0.0],
      "spread_angle": 45.0,
      "lifespan_min": 1.0,
      "lifespan_max": 4.0,
      "rate": 200.0
    },
    "update": [
      {
        "type": "update",
        "gravity": [0.0, -0.5, 0.0],
        "drag": 0.95
      },
      {
        "type": "decay"
      }
    ],
    "render": {
      "type": "sprite",
      "width": 1.0,
      "height": 1.0
    }
  }
}

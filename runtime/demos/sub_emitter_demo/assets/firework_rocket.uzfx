{
  "name": "Firework Rocket",
  "version": 1,
  "emitter": {
    "max_particles": 100,
    "emission_rate": 10.0,
    "lifetime": 3.5,
    "looping": false
  },
  "modules": {
    "spawn": {
      "type": "spawn",
      "velocity": [0.0, 0.0, 500.0],
      "spread_angle": 5.0,
      "lifespan_min": 2.0,
      "lifespan_max": 3.5,
      "rate": 10.0
    },
    "update": [
      {
        "type": "update",
        "gravity": [0.0, 0.0, -9.81],
        "drag": 0.99
      },
      {
        "type": "sub_emitter",
        "child_graph_id": 1,
        "trigger": "on_death",
        "inherit_velocity": 0.0,
        "inherit_color": true
      },
      {
        "type": "decay"
      }
    ],
    "render": {
      "type": "sprite"
    }
  }
}

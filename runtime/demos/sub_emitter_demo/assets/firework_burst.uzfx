{
  "name": "Firework Burst",
  "version": 1,
  "emitter": {
    "max_particles": 500,
    "emission_rate": 0.0,
    "lifetime": 1.5,
    "looping": false
  },
  "modules": {
    "spawn": {
      "type": "spawn",
      "velocity": [0.0, 0.0, 0.0],
      "spread_angle": 360.0,
      "lifespan_min": 0.5,
      "lifespan_max": 1.5,
      "rate": 0.0
    },
    "update": [
      {
        "type": "update",
        "gravity": [0.0, 0.0, -9.81],
        "drag": 0.98
      },
      {
        "type": "sub_emitter",
        "child_graph_id": 2,
        "trigger": "on_death",
        "inherit_velocity": 0.5,
        "inherit_color": true
      },
      {
        "type": "decay"
      }
    ],
    "render": {
      "type": "sprite"
    }
  }
}

{
  "name": "Attractor Demo",
  "version": 1,
  "emitter": {
    "max_particles": 5000,
    "emission_rate": 100.0,
    "lifetime": 4.0,
    "looping": true
  },
  "modules": {
    "spawn": {
      "type": "spawn",
      "velocity": [10.0, 0.0, 0.0],
      "spread_angle": 180.0,
      "lifespan_min": 1.0,
      "lifespan_max": 4.0,
      "rate": 100.0
    },
    "update": [
      {
        "type": "update",
        "gravity": [0.0, 0.0, 0.0],
        "drag": 1.0
      },
      {
        "type": "decay"
      },
      {
        "type": "attractor",
        "attractor_position": [0.0, 0.0, 0.0],
        "strength": 50.0,
        "radius": 200.0,
        "falloff": "inverse_square",
        "kill_on_arrival": true
      }
    ],
    "render": {
      "type": "sprite"
    }
  }
}

{
  "name": "vscode-uzengine",
  "displayName": "UzEngine Stream Viewer",
  "description": "View UzEngine DX12 renderer stream in VSCode",
  "version": "0.2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "uzscene",
        "aliases": ["UzScene", "uzscene"],
        "extensions": [".uzscene"],
        "configuration": "./syntaxes/uzscene-language-config.json"
      }
    ],
    "grammars": [
      {
        "language": "uzscene",
        "scopeName": "source.uzscene",
        "path": "./syntaxes/uzscene.tmLanguage.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "uzengine",
          "title": "UzEngine",
          "icon": "$(symbol-namespace)"
        }
      ]
    },
    "views": {
      "uzengine": [
        {
          "id": "uzengine.sceneTree",
          "name": "Scene Tree",
          "when": "true"
        },
        {
          "id": "uzengine.inspector",
          "name": "Inspector",
          "type": "webview",
          "when": "true"
        },
        {
          "id": "uzengine.console",
          "name": "Console",
          "type": "webview",
          "when": "true"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "uzengine.addNode",
          "when": "view == uzengine.sceneTree",
          "group": "navigation@1"
        },
        {
          "command": "uzengine.saveScene",
          "when": "view == uzengine.sceneTree",
          "group": "navigation@2"
        },
        {
          "command": "uzengine.refreshScene",
          "when": "view == uzengine.sceneTree",
          "group": "navigation@3"
        },
        {
          "command": "uzengine.play",
          "when": "view == uzengine.sceneTree && !uzengine.isPlaying",
          "group": "playmode@1"
        },
        {
          "command": "uzengine.pause",
          "when": "view == uzengine.sceneTree && uzengine.isPlaying && !uzengine.isPaused",
          "group": "playmode@2"
        },
        {
          "command": "uzengine.stop",
          "when": "view == uzengine.sceneTree && uzengine.isPlaying",
          "group": "playmode@3"
        },
        {
          "command": "uzengine.consoleClear",
          "when": "view == uzengine.console",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "uzengine.addNode",
          "when": "view == uzengine.sceneTree && viewItem == sceneNode",
          "group": "1_scene@1"
        },
        {
          "command": "uzengine.duplicateNode",
          "when": "view == uzengine.sceneTree && viewItem == sceneNode",
          "group": "1_scene@2"
        },
        {
          "command": "uzengine.renameNode",
          "when": "view == uzengine.sceneTree && viewItem == sceneNode",
          "group": "1_scene@3"
        },
        {
          "command": "uzengine.deleteNode",
          "when": "view == uzengine.sceneTree && viewItem == sceneNode",
          "group": "2_destructive@1"
        }
      ]
    },
    "commands": [
      {
        "command": "uzengine.openStreamViewer",
        "title": "UzEngine: Open Scene Viewport",
        "category": "UzEngine",
        "icon": "$(open-preview)"
      },
      {
        "command": "uzengine.startServer",
        "title": "UzEngine: Start Server",
        "category": "UzEngine",
        "icon": "$(debug-start)"
      },
      {
        "command": "uzengine.stopServer",
        "title": "UzEngine: Stop Server",
        "category": "UzEngine",
        "icon": "$(debug-stop)"
      },
      {
        "command": "uzengine.addNode",
        "title": "Add Node",
        "category": "UzEngine",
        "icon": "$(add)"
      },
      {
        "command": "uzengine.deleteNode",
        "title": "Delete Node",
        "category": "UzEngine",
        "icon": "$(trash)"
      },
      {
        "command": "uzengine.renameNode",
        "title": "Rename Node",
        "category": "UzEngine",
        "icon": "$(edit)"
      },
      {
        "command": "uzengine.duplicateNode",
        "title": "Duplicate Node",
        "category": "UzEngine",
        "icon": "$(copy)"
      },
      {
        "command": "uzengine.selectNode",
        "title": "Select Node",
        "category": "UzEngine"
      },
      {
        "command": "uzengine.saveScene",
        "title": "Save Scene",
        "category": "UzEngine",
        "icon": "$(save)"
      },
      {
        "command": "uzengine.refreshScene",
        "title": "Refresh Scene",
        "category": "UzEngine",
        "icon": "$(refresh)"
      },
      {
        "command": "uzengine.play",
        "title": "Play",
        "category": "UzEngine",
        "icon": "$(play)"
      },
      {
        "command": "uzengine.pause",
        "title": "Pause",
        "category": "UzEngine",
        "icon": "$(debug-pause)"
      },
      {
        "command": "uzengine.stop",
        "title": "Stop",
        "category": "UzEngine",
        "icon": "$(debug-stop)"
      },
      {
        "command": "uzengine.consoleClear",
        "title": "Clear Console",
        "category": "UzEngine",
        "icon": "$(clear-all)"
      }
    ],
    "configuration": {
      "title": "UzEngine",
      "properties": {
        "uzengine.serverUrl": {
          "type": "string",
          "default": "ws://localhost:9002",
          "description": "WebSocket server URL for the UzEngine stream"
        },
        "uzengine.serverExecutable": {
          "type": "string",
          "default": "",
          "description": "Absolute path to UzEngine.exe. Leave empty to auto-detect in build/Release or build/Debug."
        },
        "uzengine.ipcDirectory": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the IPC directory (command.json/response.json). Leave empty to auto-detect."
        },
        "uzengine.viewport.sceneTargetFps": {
          "type": "number",
          "default": 60,
          "description": "Target frame rate for the scene viewport."
        },
        "uzengine.viewport.sceneJpegQuality": {
          "type": "number",
          "default": 85,
          "description": "JPEG quality (75–95) for the scene viewport stream."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies",
    "lint": "eslint src",
    "test": "jest --coverage",
    "type-check": "tsc --noEmit"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src"],
    "testMatch": ["**/__tests__/**/*.test.ts"],
    "moduleNameMapper": {
      "^vscode$": "<rootDir>/src/__mocks__/vscode.ts",
      "^ws$": "<rootDir>/src/__mocks__/ws.ts"
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/__mocks__/**",
      "!src/__tests__/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    },
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", {
        "tsconfig": {
          "strict": true,
          "esModuleInterop": true,
          "module": "commonjs",
          "target": "ES2020",
          "lib": ["ES2020"],
          "resolveJsonModule": true,
          "noUnusedLocals": false,
          "noUnusedParameters": false
        }
      }]
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0"
  }
}

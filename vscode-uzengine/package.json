{
  "name": "vscode-uzengine",
  "displayName": "UzEngine Stream Viewer",
  "description": "View UzEngine DX12 renderer stream in VSCode",
  "version": "0.1.0",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "uzengine.openStreamViewer",
        "title": "UzEngine: Open Stream Viewer"
      }
    ],
    "configuration": {
      "title": "UzEngine",
      "properties": {
        "uzengine.serverUrl": {
          "type": "string",
          "default": "ws://localhost:9002",
          "description": "WebSocket server URL for the UzEngine stream"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0",
    "eslint": "^9.0.0"
  }
}

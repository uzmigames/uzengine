{
  "name": "vscode-uzengine",
  "displayName": "UzEngine Stream Viewer",
  "description": "View UzEngine DX12 renderer stream in VSCode",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "uzengine.openStreamViewer",
        "title": "UzEngine: Open Stream Viewer",
        "category": "UzEngine"
      },
      {
        "command": "uzengine.startServer",
        "title": "UzEngine: Start Server",
        "category": "UzEngine"
      },
      {
        "command": "uzengine.stopServer",
        "title": "UzEngine: Stop Server",
        "category": "UzEngine"
      }
    ],
    "configuration": {
      "title": "UzEngine",
      "properties": {
        "uzengine.serverUrl": {
          "type": "string",
          "default": "ws://localhost:9002",
          "description": "WebSocket server URL for the UzEngine stream"
        },
        "uzengine.serverExecutable": {
          "type": "string",
          "default": "",
          "description": "Absolute path to UzEngine.exe. Leave empty to auto-detect in build/Release or build/Debug."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^9.0.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0"
  }
}

{
  "scopeName": "markdown.uzengine.codeblock",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [
    { "include": "#uzmat-fenced-code-block" },
    { "include": "#uzfx-fenced-code-block" },
    { "include": "#uzbt-fenced-code-block" },
    { "include": "#uzcam-fenced-code-block" },
    { "include": "#uzterrain-fenced-code-block" },
    { "include": "#uzproj-fenced-code-block" },
    { "include": "#uzplugin-fenced-code-block" }
  ],
  "repository": {
    "uzmat-fenced-code-block": {
      "begin": "(^|\\G)(\\s*)((`{3,})\\s*(?i:(uzmat))(\\s+[^`]*)?\\s*)$",
      "end": "(^|\\G)(\\2|\\s{0,3})(\\4)\\s*$",
      "beginCaptures": {
        "4": { "name": "punctuation.definition.markdown" },
        "5": { "name": "fenced_code.block.language.markdown" }
      },
      "endCaptures": {
        "3": { "name": "punctuation.definition.markdown" }
      },
      "name": "markup.fenced_code.block.markdown",
      "contentName": "meta.embedded.block.uzmat",
      "patterns": [
        { "include": "source.uzmat" }
      ]
    },

{
  "comments": {
    "lineComment": "--",
    "blockComment": ["--[[", "]]"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string"] },
    { "open": "[[", "close": "]]" }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "folding": {
    "markers": {
      "start": "\\b(function|if|do|for|while|repeat)\\b",
      "end": "\\bend\\b|\\buntil\\b"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "\\b(function|if|else|elseif|for|while|repeat|do)\\b(?!.*\\bend\\b)",
    "decreaseIndentPattern": "^\\s*(end|else|elseif|until)\\b"
  },
  "wordPattern": "[a-zA-Z_][a-zA-Z0-9_]*"
}

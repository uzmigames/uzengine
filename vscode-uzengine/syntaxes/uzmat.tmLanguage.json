{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "UzMat",
  "scopeName": "source.uzmat",
  "fileTypes": [".uzmat"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#section" },
    { "include": "#keyvalue" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.uzmat",
      "match": "^\\s*[#;].*$"
    },
    "section": {
      "name": "entity.name.section.uzmat",
      "match": "^\\s*\\[([a-zA-Z_][a-zA-Z0-9_\\.]*)\\]\\s*$",
      "captures": {
        "0": { "name": "entity.name.section.uzmat" }
      }
    },
    "keyvalue": {
      "match": "^\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*(=)\\s*(.*)$",
      "captures": {
        "1": { "name": "keyword.other.key.uzmat" },
        "2": { "name": "punctuation.separator.uzmat" },
        "3": {
          "patterns": [
            { "include": "#blend-mode" },
            { "include": "#property-keyword" },
            { "include": "#boolean" },
            { "include": "#texture-path" },
            { "include": "#vec3" },
            { "include": "#number" },
            { "include": "#string-quoted" },
            { "include": "#string-unquoted" }
          ]
        }
      }
    },
    "blend-mode": {
      "name": "support.constant.blend-mode.uzmat",
      "match": "\\b(Opaque|Masked|Translucent|Additive|AlphaBlend)\\b"
    },
    "property-keyword": {
      "name": "support.type.property.uzmat",
      "match": "\\b(albedo|normal|roughness|metallic|emissive|opacity|occlusion|base_color|specular|anisotropy|sheen|clearcoat|transmission|subsurface|two_sided|cast_shadow|receive_shadow|unlit|wireframe|depth_write|depth_test|blend_mode|shader|texture|sampler|tiling|offset)\\b"
    },
    "boolean": {
      "name": "constant.language.boolean.uzmat",
      "match": "\\b(true|false|True|False|TRUE|FALSE)\\b"
    },
    "texture-path": {
      "name": "string.other.texture-path.uzmat",
      "match": "[a-zA-Z0-9_/\\.\\-]+\\.(?:png|jpg|jpeg|tga|dds|bc7|exr|hdr)"
    },
    "vec3": {
      "name": "constant.numeric.vec3.uzmat",
      "match": "-?\\b\\d+(\\.\\d+)?\\b\\s*,\\s*-?\\b\\d+(\\.\\d+)?\\b\\s*,\\s*-?\\b\\d+(\\.\\d+)?\\b"
    },
    "number": {
      "name": "constant.numeric.uzmat",
      "match": "-?\\b\\d+(\\.\\d+)?\\b"
    },
    "string-quoted": {
      "name": "string.quoted.double.uzmat",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.uzmat",
          "match": "\\\\."
        }
      ]
    },
    "string-unquoted": {
      "name": "string.unquoted.value.uzmat",
      "match": ".+"
    }
  }
}

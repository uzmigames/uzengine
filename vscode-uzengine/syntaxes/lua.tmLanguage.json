{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lua",
  "scopeName": "source.lua",
  "fileTypes": [".lua"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#keyword" },
    { "include": "#constant" },
    { "include": "#function-call" },
    { "include": "#operator" },
    { "include": "#variable" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.block.lua",
          "begin": "--\\[(=*)\\[",
          "end": "\\]\\1\\]"
        },
        {
          "name": "comment.line.double-dash.lua",
          "match": "--.*$"
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.block.lua",
          "begin": "\\[(=*)\\[",
          "end": "\\]\\1\\]"
        },
        {
          "name": "string.quoted.double.lua",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "include": "#escape" }]
        },
        {
          "name": "string.quoted.single.lua",
          "begin": "'",
          "end": "'",
          "patterns": [{ "include": "#escape" }]
        }
      ]
    },
    "escape": {
      "name": "constant.character.escape.lua",
      "match": "\\\\[abfnrtvz\\\\\"'\\n\\[\\]]|\\\\\\d{1,3}|\\\\x[0-9a-fA-F]{2}|\\\\u\\{[0-9a-fA-F]+\\}"
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.lua",
          "match": "\\b0[xX][0-9a-fA-F]+(\\.[0-9a-fA-F]+)?([pP][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.float.lua",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.float.lua",
          "match": "\\b\\d+[eE][+-]?\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.lua",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.lua",
          "match": "\\b(break|do|else|elseif|end|for|goto|if|in|repeat|return|then|until|while)\\b"
        },
        {
          "name": "keyword.operator.lua",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "storage.type.function.lua",
          "match": "\\b(function)\\b"
        },
        {
          "name": "keyword.local.lua",
          "match": "\\b(local)\\b"
        }
      ]
    },
    "constant": {
      "patterns": [
        {
          "name": "constant.language.lua",
          "match": "\\b(true|false|nil)\\b"
        },
        {
          "name": "variable.language.self.lua",
          "match": "\\b(self)\\b"
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "name": "meta.function-call.lua",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.lua" }
          }
        },
        {
          "name": "meta.function-call.method.lua",
          "match": "(?<=:)([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.lua" }
          }
        },
        {
          "name": "support.function.library.lua",
          "match": "\\b(print|type|tostring|tonumber|error|assert|pcall|xpcall|pairs|ipairs|next|select|unpack|rawget|rawset|rawequal|rawlen|setmetatable|getmetatable|require|dofile|loadfile|load|collectgarbage)\\b"
        }
      ]
    },
    "operator": {
      "name": "keyword.operator.lua",
      "match": "\\+|-|%|\\*|/|\\^|==|~=|<=|>=|<|>|=|\\.\\.|\\.\\.\\.|\\.\\.|#"
    },
    "variable": {
      "patterns": [
        {
          "name": "support.variable.library.lua",
          "match": "\\b(math|string|table|io|os|coroutine|debug|package|utf8)\\b"
        }
      ]
    }
  }
}

{
  "name": "Cloud M3 temporal motion verification",
  "version": "1.0",
  "content_root": "../../../sample/content",
  "default_scene": "../../docs/analysis/volumetric-clouds-rewrite/m3-motion.uzscene",
  "window": { "width": 1280, "height": 720 },
  "cvars": {
    "r.AutoExposure": 0, "r.Exposure": 1, "r.GTAO": 0,
    "r.RadianceCache": 0, "r.GI.FinalGather": 0, "r.GI.Reflections": 0,
    "r.SSGI": 0, "r.TAA": 1, "r.Fog": 0, "r.TechPanel.Show": 0
  }
}

# embed_shaders.cmake -- Convert HLSL source files into C string literal headers.
#
# Usage:
#   include(cmake/embed_shaders.cmake)
#   embed_shaders(
#       SOURCE_DIR  src/engine/renderer/shaders
#       OUTPUT_DIR  ${CMAKE_BINARY_DIR}/generated/shaders
#   )
#
# For each file `foo.vs.hlsl` in SOURCE_DIR, produces `foo_vs_hlsl.h` in
# OUTPUT_DIR containing the shader source as a C string constant.
#
# Large shaders (>14000 chars) are split into concatenated raw string literals
# to stay under MSVC's 16380-char string literal limit.

function(embed_shaders)
    cmake_parse_arguments(ES "" "SOURCE_DIR;OUTPUT_DIR" "" ${ARGN})

    if(NOT ES_SOURCE_DIR OR NOT ES_OUTPUT_DIR)
        message(FATAL_ERROR "embed_shaders: SOURCE_DIR and OUTPUT_DIR required")
    endif()

    file(MAKE_DIRECTORY "${ES_OUTPUT_DIR}")

    file(GLOB_RECURSE SHADER_FILES "${ES_SOURCE_DIR}/*.hlsl")

    set(CHUNK_LIMIT 14000)

    foreach(SHADER_FILE ${SHADER_FILES})
        file(READ "${SHADER_FILE}" SHADER_SOURCE)

        get_filename_component(SHADER_BASENAME "${SHADER_FILE}" NAME)
        string(REPLACE "." "_" SHADER_VAR_NAME "${SHADER_BASENAME}")

        set(OUTPUT_HEADER "${ES_OUTPUT_DIR}/${SHADER_VAR_NAME}.h")

        string(LENGTH "${SHADER_SOURCE}" SRC_LEN)

        set(_header "// AUTO-GENERATED by embed_shaders.cmake -- DO NOT EDIT\n")
        string(APPEND _header "// Source: ${SHADER_BASENAME}\n")
        string(APPEND _header "#pragma once\n\n")

        if(SRC_LEN LESS ${CHUNK_LIMIT})
            # Small shader: single raw string literal
            string(APPEND _header "static const char k_${SHADER_VAR_NAME}[] = R\"HLSL(${SHADER_SOURCE})HLSL\";\n")
        else()
            # Large shader: split into concatenated raw string literals at line boundaries
            string(APPEND _header "static const char k_${SHADER_VAR_NAME}[] =\n")

            set(_remaining "${SHADER_SOURCE}")
            set(_chunk_idx 0)

            while(TRUE)
                string(LENGTH "${_remaining}" _rem_len)
                if(_rem_len EQUAL 0)
                    break()
                endif()

                if(_rem_len LESS_EQUAL ${CHUNK_LIMIT})
                    # Last chunk
                    string(APPEND _header "R\"HLSL(${_remaining})HLSL\";\n")
                    break()
                endif()

                # Find a newline near the chunk limit to split at
                set(_split_pos ${CHUNK_LIMIT})
                # Search backward from CHUNK_LIMIT for a newline
                string(SUBSTRING "${_remaining}" 0 ${_split_pos} _search_area)
                string(FIND "${_search_area}" "\n" _nl_pos REVERSE)

                if(_nl_pos LESS 1)
                    # No newline found, just split at limit
                    set(_nl_pos ${CHUNK_LIMIT})
                endif()

                math(EXPR _nl_pos_plus "${_nl_pos} + 1")
                string(SUBSTRING "${_remaining}" 0 ${_nl_pos_plus} _chunk)
                string(SUBSTRING "${_remaining}" ${_nl_pos_plus} -1 _remaining)

                string(APPEND _header "R\"HLSL(${_chunk})HLSL\"\n")

                math(EXPR _chunk_idx "${_chunk_idx} + 1")
            endwhile()
        endif()

        # Only write if content changed (avoids unnecessary rebuilds)
        if(EXISTS "${OUTPUT_HEADER}")
            file(READ "${OUTPUT_HEADER}" EXISTING_CONTENT)
            if("${EXISTING_CONTENT}" STREQUAL "${_header}")
                continue()
            endif()
        endif()

        file(WRITE "${OUTPUT_HEADER}" "${_header}")
        message(STATUS "Embedded shader: ${SHADER_BASENAME} -> ${SHADER_VAR_NAME}.h")
    endforeach()
endfunction()

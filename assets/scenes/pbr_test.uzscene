light_intensity = 3.0

[node]
name = Test Sphere
type = StaticMesh
position = 0 2 0
scale = 2 2 2
mesh = assets/meshes/sphere.gltf
material = assets/materials/stonebricks.uzmat

[editor]
camera_position = 0 2 -4
camera_yaw = 0
camera_pitch = 0
camera_speed = 5.0

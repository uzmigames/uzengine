[uzscene]
name = PBR Test
version = 1

[node]
name = Main Camera
type = Camera
position = 0 2 -4
rotation = 0 0 0 1
fov = 45
near = 0.1
far = 1000

[node]
name = Sun
type = DirectionalLight
rotation = -0.4 -0.5 0.3 0
